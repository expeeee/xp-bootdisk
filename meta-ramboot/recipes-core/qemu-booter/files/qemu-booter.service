[Unit]
Description=Seamless QEMU RAM-Boot & VFIO Passthrough Manager
Requires=media-usb.mount
After=media-usb.mount network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
ExecStart=/usr/bin/qemu-booter
Restart=no
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
